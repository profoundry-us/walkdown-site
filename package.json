{
	"name": "walkdown-site-mockup",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "tailwindcss -i style.css -o assets/site.css --minify",
		"watch:css": "tailwindcss -i style.css -o assets/site.css --watch=always",
		"predev": "npm run build",
		"dev": "node --watch server.js --watch-css",
		"prestart": "npm run build",
		"start": "node server.js",
		"pretest": "npm run build",
		"test": "node --test *.test.js",
		"sync:setup": "cp ../walkdown/site/setup.md setup.md"
	},
	"engines": {
		"node": ">=20"
	},
	"devDependencies": {
		"@tailwindcss/cli": "4.3.3",
		"daisyui": "5.7.35",
		"tailwindcss": "4.3.3"
	}
}
